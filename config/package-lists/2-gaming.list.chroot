# ── Gaming + Windows compatibility ───────────────────────────────────────────
# Wine-Staging, Steam, Proton support, performance tools.
# Third-party repos (WineHQ, etc.) are added by the 0100 hook.

# 32-bit support (required for Steam + Wine)
# lib32gcc-s1  ← installed by wine hook
# libc6-i386   ← installed by wine hook

# Wine (WineHQ staging — added via hook, listed here for reference)
# winehq-staging  ← installed by hook after repo is added

# Native Debian wine as fallback during build
wine
wine32
wine64
winetricks
cabextract

# Steam (downloads and installs itself on first run)
steam-installer

# Lutris (universal game launcher)
lutris

# Performance + overlay
gamemode
mangohud

# gamescope — per-game micro-compositor: native-res render + FSR upscale, frame cap,
# HDR/VRR, proper fullscreen. The "best choice per actual screen resolution" engine.
# (Packaged in trixie; not available on bookworm.)
gamescope

# Vulkan + DXVK support — 64-bit AND 32-bit (32-bit is required or DXVK silently fails
# on 32-bit games)
mesa-vulkan-drivers
mesa-vulkan-drivers:i386
libgl1-mesa-dri:i386
libglx-mesa0:i386
vulkan-tools
libvulkan1
libvulkan1:i386

# umu-launcher — run non-Steam games with Proton + the Steam Linux Runtime + protonfixes
# (per-game auto-config). The substrate for the recipe/CDE layer.
umu-launcher

# Controller support beyond Steam Input (udev rules so any pad works system-wide)
steam-devices

# Proton-GE is downloaded by the 0200 hook at build time

# Utilities
innoextract
dosbox
