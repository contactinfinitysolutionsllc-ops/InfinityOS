# ── Applications ─────────────────────────────────────────────────────────────

# Browser — Firefox ESR hardened via system policy (see includes.chroot)
# uBlock Origin is deployed via the firefox hook, not as a package
firefox-esr

# Office
libreoffice
libreoffice-kf6
libreoffice-plasma

# Native-app ecosystem (Flathub) — unlocks Bottles / ProtonUp-Qt / Discord / OBS without
# bloating the base, and powers the native-first compat strategy
flatpak
plasma-discover-backend-flatpak

# System tools
htop
btop
gparted
timeshift
# fastfetch replaces neofetch (neofetch was removed from Debian in the trixie cycle)
fastfetch

# Archive support
unrar

# Calamares graphical installer
# (vlc, unzip, wget, curl already in other lists — apt dedupes)
calamares

# NOTE: InfinityMO and InfinityGuard are not included yet.
# Linux versions are in development — will be added when ready.
