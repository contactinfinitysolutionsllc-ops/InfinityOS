#!/bin/bash
# 0400-infinity-setup.hook.chroot
# Sets up the InfinityOS AI service (llama.cpp) and first-boot experience.
#
# NOTE: InfinityMO and InfinityGuard are not included yet — Linux versions
# are in development. They will be added to this hook when ready.

set -euo pipefail

# ── Restore working DNS for build-time downloads ──────────────────────────────
# Hook 0300 writes DNS=127.0.0.1 to the systemd-resolved drop-in config.
# systemd-resolved (or stubby's postinstall) may have already updated
# /etc/resolv.conf to point at 127.0.0.1 — but stubby isn't running in the
# chroot, so any wget/curl will fail with "unable to resolve host".
# Restore real DNS now; we'll write the stubby config at the very end of this
# hook after all downloads are complete.
cat > /etc/resolv.conf << 'EOF'
# Temporary build-time DNS — replaced by stubby config at end of this hook
nameserver 8.8.8.8
nameserver 8.8.4.4
EOF

echo ">>> Setting up InfinityOS AI service..."

# ── llama.cpp AI service ──────────────────────────────────────────────────────
# Install the llama-server binary. The AI model itself (~2.2 GB) is
# downloaded on first boot by infinity-first-boot.service to keep the ISO lean.

LLAMA_VER="b5574"
LLAMA_ASSET="llama-${LLAMA_VER}-bin-ubuntu-x64.zip"
LLAMA_URL="https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_VER}/${LLAMA_ASSET}"

mkdir -p /opt/infinity-ai/bin
wget -qO /tmp/llama.zip "${LLAMA_URL}"
unzip -q /tmp/llama.zip -d /tmp/llama-extract

# Copy llama-server binary (name varies across llama.cpp releases)
if find /tmp/llama-extract -name "llama-server" -type f | grep -q .; then
    find /tmp/llama-extract -name "llama-server" -type f -exec cp {} /opt/infinity-ai/bin/llama-server \;
elif find /tmp/llama-extract -name "server" -type f | grep -q .; then
    find /tmp/llama-extract -name "server" -type f -exec cp {} /opt/infinity-ai/bin/llama-server \;
else
    echo "ERROR: neither 'llama-server' nor 'server' binary found in zip"
    find /tmp/llama-extract -type f | head -20
    exit 1
fi

chmod +x /opt/infinity-ai/bin/llama-server
rm -rf /tmp/llama.zip /tmp/llama-extract

echo ">>> llama-server installed."

# Dedicated system user — no login, no home, runs the AI process only
useradd --system --no-create-home --shell /usr/sbin/nologin infinity-ai || true
mkdir -p /var/lib/infinity-ai
chown infinity-ai:infinity-ai /var/lib/infinity-ai

# systemd service — starts only after first-boot downloads the model
# Performance flags explained:
#   --threads 4        : use half the CPU cores (leaves rest for desktop/games)
#   --ctx-size 4096    : 4K context — enough for long conversations, not wasteful
#   --batch-size 256   : smaller batch = lower RAM spike during inference
#   --mmap             : memory-map the model file (faster load, shares pages with OS)
#   --cont-batching    : allow concurrent requests without blocking
#   --no-mmap is NOT set — mmap is beneficial here
cat > /etc/systemd/system/infinity-ai.service << 'EOF'
[Unit]
Description=InfinityOS Local AI Service (llama.cpp / Phi-3.5-mini)
Documentation=https://github.com/contactinfinitysolutionsllc-ops/InfinityOS
After=network-online.target infinity-first-boot.service
ConditionPathExists=/var/lib/infinity-ai/model.gguf

[Service]
Type=simple
User=infinity-ai
Group=infinity-ai
# Nice+10: AI inference is background work — yields to foreground tasks (games, desktop)
Nice=10
# Limit to 60% CPU so gaming/desktop always has headroom
CPUQuota=60%
ExecStart=/opt/infinity-ai/bin/llama-server \
    --model /var/lib/infinity-ai/model.gguf \
    --host 127.0.0.1 \
    --port 8080 \
    --ctx-size 4096 \
    --batch-size 256 \
    --threads 4 \
    --mmap \
    --cont-batching \
    --log-disable
Restart=on-failure
RestartSec=15
# Prevent the AI service from eating disk on log spam
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

systemctl enable infinity-ai.service || true
echo ">>> AI service configured (tuned: Nice+10, CPUQuota=60%, mmap, ctx=4096)."

# ── Infinity Assistant agent ───────────────────────────────────────────────────
# The Python agent wrapper that gives users a real interface to the AI.
# Lives at /usr/local/bin/infinity-assistant (already dropped via includes.chroot).
chmod +x /usr/local/bin/infinity-assistant
echo ">>> infinity-assistant agent: executable set."

# Ensure the playbook directory is readable by all users
chmod -R a+rX /usr/share/infinity-assistant/
echo ">>> infinity-assistant knowledge base: permissions set."

# ── First-boot service ────────────────────────────────────────────────────────
# Downloads the AI model once after install. Shows a KDE notification
# so the user knows what is happening.

cat > /usr/local/bin/infinity-first-boot << 'SCRIPT'
#!/bin/bash
set -e

SENTINEL="/var/lib/infinity-ai/.setup-complete"
[ -f "${SENTINEL}" ] && exit 0

MODEL_URL="https://huggingface.co/bartowski/Phi-3.5-mini-instruct-GGUF/resolve/main/Phi-3.5-mini-instruct-Q4_K_M.gguf"
MODEL_PATH="/var/lib/infinity-ai/model.gguf"

echo "InfinityOS: downloading AI model (~2.2 GB)..."

# Notify the logged-in KDE user if one exists
DBUS_SESSION=$(find /run/user -name "bus" 2>/dev/null | head -1)
if [ -n "${DBUS_SESSION}" ]; then
    DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=${DBUS_SESSION}" \
    notify-send "InfinityOS Setup" \
        "Downloading local AI model (~2.2 GB). This runs once and takes a few minutes." \
        --icon=dialog-information --app-name="InfinityOS" 2>/dev/null || true
fi

wget --progress=dot:giga -O "${MODEL_PATH}.tmp" "${MODEL_URL}"
mv "${MODEL_PATH}.tmp" "${MODEL_PATH}"
chown infinity-ai:infinity-ai "${MODEL_PATH}"

touch "${SENTINEL}"
systemctl start infinity-ai.service

if [ -n "${DBUS_SESSION}" ]; then
    DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=${DBUS_SESSION}" \
    notify-send "InfinityOS Ready" \
        "Local AI assistant is online. Click 'Infinity Assistant' in the dock to start." \
        --icon=dialog-information --app-name="InfinityOS" 2>/dev/null || true
fi

echo "InfinityOS: AI model ready."
SCRIPT

chmod +x /usr/local/bin/infinity-first-boot

cat > /etc/systemd/system/infinity-first-boot.service << 'EOF'
[Unit]
Description=InfinityOS First Boot Setup (AI model download)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/infinity-ai/.setup-complete

[Service]
Type=oneshot
ExecStart=/usr/local/bin/infinity-first-boot
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
EOF

systemctl enable infinity-first-boot.service || true
echo ">>> First-boot setup service configured."

# ── KDE default settings for all users ───────────────────────────────────────
mkdir -p /etc/skel/.config

cat > /etc/skel/.config/kdeglobals << 'EOF'
[General]
TerminalApplication=konsole
TerminalService=org.kde.konsole

[KDE]
ColorScheme=BreezeDark
LookAndFeelPackage=org.kde.breezedark.desktop
SingleClick=false
widgetStyle=Breeze

[Icons]
Theme=breeze-dark
EOF

cat > /etc/skel/.config/plasmarc << 'EOF'
[Theme]
name=breeze-dark
EOF

cat > /etc/skel/.config/kwinrc << 'EOF'
[Compositing]
Backend=OpenGL
GLCore=true
Enabled=true

[Windows]
BorderlessMaximizedWindows=false
EOF

echo ">>> KDE defaults configured."

# ── InfinityGuard Security Suite ─────────────────────────────────────────────
# The InfinityGuard .deb is expected in config/packages.chroot/
# live-build installs it automatically before this hook runs.
# This section handles InfinityOS-specific post-install configuration.

if dpkg -l infinityguard &>/dev/null; then
    echo ">>> InfinityGuard is installed — applying InfinityOS configuration..."

    # ── Tune IG config for InfinityOS ────────────────────────────────────────
    # Disable auto-update check on first boot (we'll do it via first-boot svc)
    # and point AI explanation at the local llama.cpp server.
    if [ -f /etc/infinityguard/config.json ]; then
        python3 - << 'PYEOF'
import json, sys
cfg_path = "/etc/infinityguard/config.json"
try:
    with open(cfg_path) as f:
        cfg = json.load(f)
    # Enable local AI explanation via llama.cpp on InfinityOS
    cfg.setdefault("ai", {})["local_endpoint"] = "http://127.0.0.1:8080"
    cfg["ai"]["mode"] = "local"
    # Tighten fanotify for OS use (also watch /usr/local)
    cfg.setdefault("fanotify", {})["watch_paths"] = [
        "/home", "/root", "/tmp", "/var/tmp",
        "/opt", "/usr/local/bin", "/usr/local/sbin"
    ]
    # InfinityOS ships ClamAV — mark it available
    cfg.setdefault("engines", {})["clamav_path"] = "/usr/bin/clamdscan"
    with open(cfg_path, "w") as f:
        json.dump(cfg, f, indent=2)
    print("  IG config patched for InfinityOS.")
except Exception as e:
    print(f"  Warning: could not patch IG config: {e}")
PYEOF
    fi

    # ── IG first-boot IE feed sync ────────────────────────────────────────────
    # The Infinity Engine threat feed database is empty on first install.
    # We download it on first boot — same as the AI model download pattern.
    cat > /usr/local/bin/ig-first-boot << 'SCRIPT'
#!/bin/bash
set -e
SENTINEL="/var/lib/infinityguard/.ie-setup-complete"
[ -f "${SENTINEL}" ] && exit 0

# Notify user
DBUS_SESSION=$(find /run/user -name "bus" 2>/dev/null | head -1)
_notify() {
    [ -n "${DBUS_SESSION}" ] || return 0
    DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS="unix:path=${DBUS_SESSION}" \
    notify-send "$1" "$2" --icon=security-high --app-name="InfinityGuard" 2>/dev/null || true
}

_notify "InfinityGuard" "Downloading threat intelligence feeds (first run)..."
echo "InfinityGuard: syncing Infinity Engine threat feeds..."

# Call IG's update endpoint if service is already running
if curl -sf http://127.0.0.1:54321/ready &>/dev/null; then
    curl -sf -X POST http://127.0.0.1:54321/update/run &>/dev/null || true
else
    # Service not up yet — run updater directly
    /usr/bin/python3 /opt/infinityguard/core/ig_update.py --quiet || true
fi

# Update ClamAV definitions too
freshclam --no-warnings 2>/dev/null || true

touch "${SENTINEL}"
_notify "InfinityGuard Ready" \
    "Threat intelligence updated. Real-time protection is active."
echo "InfinityGuard: first-boot setup complete."
SCRIPT

    chmod +x /usr/local/bin/ig-first-boot

    cat > /etc/systemd/system/ig-first-boot.service << 'EOF'
[Unit]
Description=InfinityGuard First Boot — Threat Intelligence Sync
After=network-online.target infinityguard.service
Wants=network-online.target
ConditionPathExists=!/var/lib/infinityguard/.ie-setup-complete

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ig-first-boot
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

    systemctl enable ig-first-boot.service || true
    echo ">>> IG first-boot IE sync service configured."

    # ── AppArmor profile is already installed by postinst ────────────────────
    # Load it now in the chroot so it's active on first boot without a reboot
    if command -v apparmor_parser &>/dev/null && [ -f /etc/apparmor.d/infinityguard ]; then
        apparmor_parser -r /etc/apparmor.d/infinityguard 2>/dev/null || true
        echo ">>> AppArmor profile loaded."
    fi

    echo ">>> InfinityGuard InfinityOS integration complete."
else
    echo ">>> WARNING: infinityguard package not found."
    echo "    To include InfinityGuard in the build:"
    echo "    1. Run: bash linux/build-deb.sh"
    echo "    2. Copy the .deb to: InfinityOS/config/packages.chroot/"
    echo "    3. Rebuild the ISO."
fi

# ── Point resolv.conf at stubby ───────────────────────────────────────────────
# All build-time downloads are done. Now route DNS through stubby (DoT).
# This must be the LAST thing that touches the network config in any hook.
cat > /etc/resolv.conf << 'EOF'
# InfinityOS — all DNS routed through stubby (DNS-over-TLS)
nameserver 127.0.0.1
options edns0 trust-ad
EOF
echo ">>> resolv.conf configured to use stubby for encrypted DNS."

echo ">>> InfinityOS setup complete."
