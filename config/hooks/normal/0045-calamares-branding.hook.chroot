#!/bin/bash
# 0045-calamares-branding.hook.chroot
# Wires up InfinityOS branding assets for the Calamares installer.
# Also installs icons into the hicolor theme so KDE renders them with
# correct transparency (icons referenced by name, not full path).

set -euo pipefail

echo ">>> Setting up Calamares branding and icons..."

BRAND_DIR="/etc/calamares/branding/infinityos"
mkdir -p "${BRAND_DIR}"

# ── Strip white backgrounds from logo PNGs ────────────────────────────────────
# The source PNGs may have a white/near-white background. We strip it using
# Python's built-in struct+zlib (no extra deps needed) via ImageMagick if
# available, otherwise mark for manual fix.
if command -v convert >/dev/null 2>&1; then
    for PNG in /usr/share/infinity/*.png; do
        convert "${PNG}" -fuzz 5% -transparent white "${PNG}" 2>/dev/null || true
    done
    echo ">>> Icon white backgrounds stripped (ImageMagick)."
else
    # Install imagemagick just for this step then we have it on the system too
    apt-get install -y --no-install-recommends imagemagick 2>/dev/null || true
    if command -v convert >/dev/null 2>&1; then
        for PNG in /usr/share/infinity/*.png; do
            convert "${PNG}" -fuzz 5% -transparent white "${PNG}" 2>/dev/null || true
        done
        echo ">>> Icon white backgrounds stripped (ImageMagick freshly installed)."
    else
        echo ">>> WARNING: ImageMagick not available — icon backgrounds not stripped."
    fi
fi

# ── Install icons into hicolor theme for proper KDE transparency ──────────────
# When icons are referenced by *name* (not full path), KDE looks them up via
# the icon theme and renders transparency correctly. Full paths can show white.
mkdir -p /usr/share/icons/hicolor/256x256/apps
mkdir -p /usr/share/icons/hicolor/128x128/apps
mkdir -p /usr/share/icons/hicolor/64x64/apps

# OS logo → infinity-os icon name
if [ -f /usr/share/infinity/infinity-logo.png ]; then
    cp /usr/share/infinity/infinity-logo.png \
       /usr/share/icons/hicolor/256x256/apps/infinity-os.png
fi

# AI assistant icon — use the alt logo variant for visual distinction
# (different from the main OS logo so they don't look identical in the dock)
if [ -f /usr/share/infinity/infinity-alt.png ]; then
    cp /usr/share/infinity/infinity-alt.png \
       /usr/share/icons/hicolor/256x256/apps/infinity-ai.png
    # Also put it at the expected full path for .desktop fallback
    cp /usr/share/infinity/infinity-alt.png \
       /usr/share/infinity/infinity-ai-icon.png
elif [ -f /usr/share/infinity/infinity-logo.png ]; then
    cp /usr/share/infinity/infinity-logo.png \
       /usr/share/icons/hicolor/256x256/apps/infinity-ai.png
    cp /usr/share/infinity/infinity-logo.png \
       /usr/share/infinity/infinity-ai-icon.png
fi

# Update icon theme cache
gtk-update-icon-cache -f /usr/share/icons/hicolor/ 2>/dev/null || true
echo ">>> Icons installed to hicolor theme (infinity-os, infinity-ai)."

# ── Update desktop entry to use icon name (not path) ─────────────────────────
sed -i 's|Icon=/usr/share/infinity/infinity-ai-icon.png|Icon=infinity-ai|' \
    /usr/share/applications/infinity-assistant.desktop 2>/dev/null || true

# ── Logo ──────────────────────────────────────────────────────────────────────
if [ -f /usr/share/infinity/infinity-logo.png ]; then
    cp /usr/share/infinity/infinity-logo.png "${BRAND_DIR}/logo.png"
    echo ">>> Calamares: logo.png installed."
else
    echo ">>> WARNING: infinity-logo.png not found — Calamares will show no logo."
fi

# ── Welcome image ─────────────────────────────────────────────────────────────
if [ -f /usr/share/infinity/infinity-wide.png ]; then
    cp /usr/share/infinity/infinity-wide.png "${BRAND_DIR}/welcome.png"
    echo ">>> Calamares: welcome.png (wide logo) installed."
elif [ -f /usr/share/infinity/infinity-logo.png ]; then
    cp /usr/share/infinity/infinity-logo.png "${BRAND_DIR}/welcome.png"
    echo ">>> Calamares: welcome.png (square logo fallback) installed."
fi

# ── Calamares desktop entry ───────────────────────────────────────────────────
cat > /usr/share/applications/calamares.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install InfinityOS
GenericName=System Installer
Comment=Install InfinityOS to your hard drive
Exec=pkexec calamares
Icon=infinity-os
Terminal=false
Categories=System;
Keywords=install;installer;setup;
X-GNOME-UsesNotifications=true
EOF

echo ">>> Calamares desktop entry created."

# ── Polkit rule so Calamares can run via pkexec ───────────────────────────────
mkdir -p /usr/share/polkit-1/actions
cat > /usr/share/polkit-1/actions/org.calamares.calamares.policy << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.calamares.calamares">
    <description>Run the Calamares installer</description>
    <message>Authentication is required to install InfinityOS</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/calamares</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
EOF

echo ">>> Calamares polkit rule installed."

# ── Pin "Install InfinityOS" to the dock during the live session ──────────────
# Prepend calamares to the launchers list in the skel dock config.
ICONTASKS_CFG="/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc"
if [ -f "${ICONTASKS_CFG}" ]; then
    # Add calamares as the first dock item (before infinity-assistant)
    sed -i 's|launchers=applications:infinity-assistant.desktop|launchers=applications:calamares.desktop,applications:infinity-assistant.desktop|' \
        "${ICONTASKS_CFG}" || true
    echo ">>> Calamares pinned to dock (live session)."
fi

# Also update the live user's copy if it already exists
LIVE_ICONTASKS="/home/user/.config/plasma-org.kde.plasma.desktop-appletsrc"
if [ -f "${LIVE_ICONTASKS}" ]; then
    sed -i 's|launchers=applications:infinity-assistant.desktop|launchers=applications:calamares.desktop,applications:infinity-assistant.desktop|' \
        "${LIVE_ICONTASKS}" || true
fi

echo ">>> Calamares branding setup complete."
