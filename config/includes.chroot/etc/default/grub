# InfinityOS GRUB configuration

GRUB_DEFAULT=0
GRUB_TIMEOUT=3
GRUB_TIMEOUT_STYLE=hidden

# This replaces "Debian GNU/Linux" in the boot menu entries
GRUB_DISTRIBUTOR="InfinityOS"

# quiet splash = suppress kernel messages, show Plymouth splash
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""

# Dark background image (generated by 0070-boot-theme hook)
GRUB_BACKGROUND="/usr/share/grub/infinityos-grub.png"

# GRUB menu colors (ANSI 16-color — best we can do in GRUB text mode)
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="white/dark-gray"

# Disable recovery menu entries (cleaner for end users)
GRUB_DISABLE_RECOVERY=true

# Enable OS prober (detects Windows on dual-boot systems)
GRUB_DISABLE_OS_PROBER=false
