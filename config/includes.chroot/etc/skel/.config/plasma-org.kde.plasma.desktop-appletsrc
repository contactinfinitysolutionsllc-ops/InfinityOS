[ActionPlugins][1]
RightButton;NoModifier=org.kde.contextmenu

[ActionPlugins][2]
RightButton;NoModifier=org.kde.contextmenu

; ── Desktop containment ──────────────────────────────────────────────────────
[Containments][1]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=/usr/share/wallpapers/InfinityOS/contents/images/1672x941.png
FillMode=1
SlideshowInterval=0

; ── Top panel ─────────────────────────────────────────────────────────────────
; Full width, 32px tall, at the top of the screen.
; Layout: [Logo+Launcher] [Spacer] [Clock] [Spacer] [System Tray]
[Containments][2]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=3
plugin=org.kde.panel

[Containments][2][Applets][3]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][2][Applets][3][Configuration]
PreloadWeight=100

[Containments][2][Applets][3][Configuration][General]
applicationButtonAction=dashboard
customButtonImage=/usr/share/infinity/infinity-logo.png
useCustomButtonImage=true

[Containments][2][Applets][4]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][2][Applets][5][Configuration][Appearance]
dateFormat=longDate
showDate=true
showSeconds=false
use24hFormat=2

[Containments][2][Applets][6]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][2][Applets][7]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][2][Applets][7][Configuration][General]
extraItems=org.kde.plasma.battery,org.kde.plasma.networkmanagement,org.kde.plasma.volume,org.kde.plasma.bluetooth,org.kde.plasma.notifications

[Containments][2][General]
AppletOrder=3;4;5;6;7

; ── Bottom floating dock ──────────────────────────────────────────────────────
; Centered, not full width — pinned apps only.
; Floats above the desktop with slight margin.
[Containments][3]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel

[Containments][3][Applets][10]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][3][Applets][10][Configuration][General]
launchers=applications:org.kde.plasma.kickoff.desktop,applications:org.kde.konsole.desktop,applications:org.kde.dolphin.desktop,applications:firefox-esr.desktop,applications:org.kde.discover.desktop,applications:systemsettings.desktop,applications:org.kde.plasma.trash.desktop
showOnlyCurrentDesktop=false
showOnlyCurrentActivity=false
showOnlyMinimized=false
groupingStrategy=1
middleClickAction=NewInstance

[Containments][3][General]
AppletOrder=10

; ── System Monitor desktop widget (bottom-right) ─────────────────────────────
[Containments][4]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.systemmonitor
popupHeight=300
popupWidth=320

[Containments][4][Applets][20]
immutability=1
plugin=org.kde.plasma.systemmonitor

[Containments][4][Applets][20][Configuration][Appearance]
title=System Overview
showTitle=true

[Containments][4][Applets][20][Configuration][SensorColors]
cpu/all/usage=138,79,255
memory/physical/used=100,140,255
disk/all/used=80,210,200

[ScreenMapping]
itemsOnDisabledScreens=
