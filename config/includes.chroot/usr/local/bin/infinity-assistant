#!/usr/bin/env python3
"""
infinity-assistant — InfinityOS local AI agent
Wraps llama-server (Phi-3.5-mini) with a confirmation gate for command execution.
Streams responses in real time, reads logs, runs fixes with user approval.
"""

import json
import os
import re
import subprocess
import sys
import urllib.request
import urllib.error
from datetime import datetime
from pathlib import Path

# ── Config ────────────────────────────────────────────────────────────────────
LLAMA_URL        = "http://127.0.0.1:8080/v1/chat/completions"
SYSTEM_PROMPT    = Path("/usr/share/infinity-assistant/system-prompt.txt")
PLAYBOOK_DIR     = Path("/usr/share/infinity-assistant/playbooks")
LOG_DIR          = Path.home() / ".local/share/infinity-assistant"
LOG_FILE         = LOG_DIR / "history.log"
MAX_OUTPUT_CHARS = 3000   # truncate huge command output before feeding back to AI
MAX_HISTORY      = 20     # keep last N messages to avoid context overflow

VERSION = "1.0"

# ── ANSI colors ───────────────────────────────────────────────────────────────
class C:
    RST    = "\033[0m"
    BOLD   = "\033[1m"
    DIM    = "\033[2m"
    PURPLE = "\033[38;5;141m"
    CYAN   = "\033[36m"
    GREEN  = "\033[32m"
    YELLOW = "\033[33m"
    RED    = "\033[31m"
    GRAY   = "\033[90m"
    WHITE  = "\033[97m"

# Commands that get an extra warning before running
DESTRUCTIVE = re.compile(
    r'(\brm\s+-[a-z]*r|\bdd\b.*of=/|\bmkfs\b|\bwipefs\b|\bshred\b'
    r'|>\s*/dev/sd[a-z]|>\s*/dev/nvme|\bformat\b)',
    re.IGNORECASE
)

# ── Logging ───────────────────────────────────────────────────────────────────
def log(entry: str):
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG_FILE, "a") as f:
        f.write(f"[{ts}] {entry}\n")

# ── System prompt ─────────────────────────────────────────────────────────────
def load_system_prompt() -> str:
    if SYSTEM_PROMPT.exists():
        return SYSTEM_PROMPT.read_text()
    return (
        "You are Infinity Assistant, the built-in AI for InfinityOS — "
        "a privacy-first, gaming-ready Linux distribution."
    )

# ── Streaming chat ────────────────────────────────────────────────────────────
def chat_stream(messages: list) -> str:
    """
    Send messages to llama-server, stream response token by token.
    Prints directly to stdout as tokens arrive.
    Returns the complete response string when done.
    """
    payload = json.dumps({
        "messages":    messages,
        "temperature": 0.25,
        "max_tokens":  1200,
        "stream":      True,
    }).encode()

    req = urllib.request.Request(
        LLAMA_URL,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    full = ""
    in_bash_block = False

    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line.startswith("data: "):
                    continue
                chunk = line[6:]
                if chunk == "[DONE]":
                    break
                try:
                    delta = json.loads(chunk)["choices"][0]["delta"].get("content", "")
                except (json.JSONDecodeError, KeyError, IndexError):
                    continue

                if not delta:
                    continue

                full += delta

                # Color-code bash blocks as they stream
                for char in delta:
                    # Track whether we're inside a code block to dim it slightly
                    # (user sees it now; will get a proper confirmation prompt later)
                    sys.stdout.write(char)
                    sys.stdout.flush()

    except urllib.error.URLError as e:
        msg = (
            f"\n{C.RED}Cannot reach the AI service.{C.RST}\n"
            f"Check status: {C.CYAN}systemctl status infinity-ai{C.RST}\n"
        )
        print(msg)
        log(f"ERROR: llama-server unreachable: {e}")
        return ""

    print()  # newline after stream ends
    return full

# ── Non-streaming fallback (for follow-up analysis calls) ────────────────────
def chat_silent(messages: list) -> str:
    payload = json.dumps({
        "messages":    messages,
        "temperature": 0.2,
        "max_tokens":  600,
        "stream":      False,
    }).encode()

    req = urllib.request.Request(
        LLAMA_URL,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            data = json.loads(resp.read())
            return data["choices"][0]["message"]["content"]
    except Exception as e:
        log(f"ERROR: silent chat failed: {e}")
        return ""

# ── Command parsing ───────────────────────────────────────────────────────────
def extract_bash_blocks(text: str) -> list:
    return [
        b.strip()
        for b in re.findall(r"```(?:bash|sh|shell)\s*\n(.*?)```", text, re.DOTALL)
        if b.strip()
    ]

# ── Command execution ─────────────────────────────────────────────────────────
def run_command(cmd: str) -> tuple:
    """Run a shell command as the current user. Returns (output, returncode)."""
    try:
        result = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=120,
        )
        out = result.stdout.strip()
        err = result.stderr.strip()
        combined = out
        if err:
            combined += f"\n[stderr] {err}" if out else f"[stderr] {err}"
        return combined, result.returncode
    except subprocess.TimeoutExpired:
        return "Command timed out after 120 seconds.", 124
    except Exception as e:
        return f"Failed to run command: {e}", 1

# ── Confirmation gate ─────────────────────────────────────────────────────────
def confirm(cmd: str, messages: list) -> str:
    """
    Show the command, ask for user approval.
    Returns: 'run' | 'skip' | 'explain' | 'quit'
    """
    print(f"\n{C.YELLOW}{'─' * 58}{C.RST}")

    if DESTRUCTIVE.search(cmd):
        print(f"{C.RED}{C.BOLD}  ⚠  POTENTIALLY DESTRUCTIVE COMMAND  ⚠{C.RST}")
        print(f"{C.RED}  Double-check this before allowing it.{C.RST}")

    print(f"  {C.BOLD}Command to run:{C.RST}")
    print(f"  {C.CYAN}{cmd}{C.RST}")
    print(f"{C.YELLOW}{'─' * 58}{C.RST}")
    print(
        f"  {C.GREEN}[Y]{C.RST} Run it  "
        f"{C.RED}[N]{C.RST} Skip  "
        f"{C.GRAY}[E]{C.RST} Explain  "
        f"{C.GRAY}[Q]{C.RST} Quit"
    )

    while True:
        try:
            choice = input(f"{C.BOLD}  > {C.RST}").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return "quit"

        if choice in ("y", "yes", ""):
            return "run"
        elif choice in ("n", "no", "skip"):
            return "skip"
        elif choice in ("e", "explain"):
            # Ask AI to explain this specific command in plain English
            explain_msgs = messages + [{
                "role": "user",
                "content": (
                    f"In 2-3 plain English sentences, explain exactly what "
                    f"this command does and why you're suggesting it:\n`{cmd}`"
                )
            }]
            print(f"\n{C.DIM}Explaining...{C.RST}")
            explanation = chat_silent(explain_msgs)
            print(f"\n{C.WHITE}{explanation}{C.RST}\n")
            # Ask again after explanation
            print(f"  {C.GREEN}[Y]{C.RST} Run it  {C.RED}[N]{C.RST} Skip  {C.GRAY}[Q]{C.RST} Quit")
        elif choice in ("q", "quit", "exit"):
            return "quit"

# ── ProtonDB lookup (opt-in) ──────────────────────────────────────────────────
def protondb_lookup(appid: str) -> str:
    """Fetch ProtonDB summary for a Steam AppID. Returns summary text or empty string."""
    url = f"https://www.protondb.com/api/v1/reports/summaries/{appid}.json"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "InfinityOS/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read())
            tier  = data.get("tier", "unknown")
            total = data.get("total", 0)
            return (
                f"ProtonDB reports for AppID {appid}: "
                f"Rating={tier.upper()}, Reports={total}"
            )
    except Exception:
        return ""

def maybe_lookup_protondb(user_input: str) -> str:
    """If user mentions a Steam AppID, offer ProtonDB lookup."""
    match = re.search(r'\b(app(?:id)?[:\s#]*)?(\d{4,7})\b', user_input, re.IGNORECASE)
    if not match:
        return ""
    appid = match.group(2)
    try:
        answer = input(
            f"\n  {C.GRAY}Found Steam AppID {appid}. "
            f"Check ProtonDB for compatibility reports? [Y/N]{C.RST} "
        ).strip().lower()
        if answer in ("y", "yes"):
            result = protondb_lookup(appid)
            if result:
                print(f"  {C.GRAY}{result}{C.RST}")
                return result
    except (EOFError, KeyboardInterrupt):
        pass
    return ""

# ── File reading helper ───────────────────────────────────────────────────────
def try_read_file(path: str) -> str:
    """Read a file and return its contents (last 200 lines for logs)."""
    p = Path(path.strip()).expanduser()
    if not p.exists():
        return f"[File not found: {path}]"
    try:
        lines = p.read_text(errors="replace").splitlines()
        if len(lines) > 200:
            lines = lines[-200:]
            prefix = f"[Last 200 lines of {path}]\n"
        else:
            prefix = f"[Contents of {path}]\n"
        return prefix + "\n".join(lines)
    except Exception as e:
        return f"[Cannot read {path}: {e}]"

# ── Header ────────────────────────────────────────────────────────────────────
def print_header():
    print(f"\n{C.PURPLE}{C.BOLD}")
    print("   ╔════════════════════════════════════════╗")
    print("   ║       Infinity Assistant  v" + VERSION + "         ║")
    print("   ║   Local AI · Offline · Privacy First   ║")
    print("   ╚════════════════════════════════════════╝")
    print(C.RST)
    print(f"   {C.DIM}Model : Phi-3.5-mini (runs 100% on your machine){C.RST}")
    print(f"   {C.DIM}Log   : {LOG_FILE}{C.RST}")
    print(f"   {C.DIM}Commands need your approval before they run.{C.RST}")
    print(f"   {C.DIM}Type 'exit' to quit  |  'log' to open the audit log{C.RST}\n")

# ── Trim history to avoid context overflow ────────────────────────────────────
def trim_history(messages: list) -> list:
    """Keep system prompt + last MAX_HISTORY messages."""
    system = [m for m in messages if m["role"] == "system"]
    rest   = [m for m in messages if m["role"] != "system"]
    if len(rest) > MAX_HISTORY:
        rest = rest[-MAX_HISTORY:]
    return system + rest

# ── Main loop ─────────────────────────────────────────────────────────────────
def main():
    print_header()

    system_prompt = load_system_prompt()
    messages = [{"role": "system", "content": system_prompt}]
    log("=== Session started ===")

    while True:
        # ── Get user input ────────────────────────────────────────────────────
        try:
            user_input = input(f"{C.PURPLE}{C.BOLD}You: {C.RST}").strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{C.DIM}Goodbye.{C.RST}")
            log("=== Session ended ===")
            break

        if not user_input:
            continue

        # ── Built-in commands ────────────────────────────────────────────────
        if user_input.lower() in ("exit", "quit", "bye"):
            print(f"{C.DIM}Goodbye.{C.RST}")
            log("=== Session ended ===")
            break

        if user_input.lower() == "log":
            subprocess.run(["xdg-open", str(LOG_FILE)], check=False)
            continue

        if user_input.lower().startswith("read "):
            path = user_input[5:].strip()
            content = try_read_file(path)
            print(f"{C.DIM}{content}{C.RST}\n")
            user_input = f"I've loaded this file for you to analyze:\n{content}"

        # ── Optional ProtonDB lookup ──────────────────────────────────────────
        protondb_info = maybe_lookup_protondb(user_input)
        if protondb_info:
            user_input += f"\n\n[ProtonDB data]: {protondb_info}"

        log(f"USER: {user_input}")
        messages.append({"role": "user", "content": user_input})
        messages = trim_history(messages)

        # ── Stream AI response ────────────────────────────────────────────────
        print(f"\n{C.WHITE}{C.BOLD}Assistant:{C.RST} ", end="", flush=True)
        response = chat_stream(messages)

        if not response:
            messages.pop()  # drop failed turn
            continue

        log(f"ASSISTANT: {response[:500]}")
        messages.append({"role": "assistant", "content": response})

        # ── Handle bash blocks ────────────────────────────────────────────────
        commands = extract_bash_blocks(response)
        all_results = []

        for cmd in commands:
            choice = confirm(cmd, messages)

            if choice == "quit":
                print(f"{C.DIM}Goodbye.{C.RST}")
                log("=== Session ended by user ===")
                sys.exit(0)

            elif choice == "skip":
                log(f"SKIPPED: {cmd}")
                all_results.append(f"$ {cmd}\n[User skipped this command]")
                print(f"  {C.DIM}Skipped.{C.RST}")
                continue

            # Run it
            log(f"EXECUTED: {cmd}")
            print(f"  {C.DIM}Running...{C.RST}", end="\r")
            output, rc = run_command(cmd)
            status_icon = f"{C.GREEN}✓{C.RST}" if rc == 0 else f"{C.RED}✗ (exit {rc}){C.RST}"
            print(f"  {status_icon}              ")  # clear "Running..."

            if output:
                display = output if len(output) < 1500 else output[:1500] + "\n  [... output truncated ...]"
                print(f"\n{C.DIM}{display}{C.RST}\n")

            log(f"OUTPUT rc={rc}: {output[:400]}")
            all_results.append(
                f"$ {cmd}\n"
                f"exit code: {rc}\n"
                f"{output[:MAX_OUTPUT_CHARS]}"
            )

        # ── Feed results back to AI for analysis ──────────────────────────────
        if all_results:
            feedback = "\n\n".join(all_results)
            messages.append({
                "role": "user",
                "content": (
                    f"Here is the output from those commands:\n\n{feedback}\n\n"
                    "What does this tell you? Is the issue resolved, "
                    "or is there a next step?"
                )
            })
            messages = trim_history(messages)

            print(f"\n{C.WHITE}{C.BOLD}Assistant:{C.RST} ", end="", flush=True)
            followup = chat_stream(messages)

            if followup:
                log(f"FOLLOWUP: {followup[:400]}")
                messages.append({"role": "assistant", "content": followup})

                # Handle any follow-up commands
                for cmd in extract_bash_blocks(followup):
                    choice = confirm(cmd, messages)
                    if choice == "quit":
                        sys.exit(0)
                    elif choice == "run":
                        log(f"EXECUTED: {cmd}")
                        output, rc = run_command(cmd)
                        icon = f"{C.GREEN}✓{C.RST}" if rc == 0 else f"{C.RED}✗{C.RST}"
                        print(f"  {icon}")
                        if output:
                            print(f"\n{C.DIM}{output[:1500]}{C.RST}\n")
                        log(f"OUTPUT rc={rc}: {output[:400]}")
                    else:
                        log(f"SKIPPED: {cmd}")

if __name__ == "__main__":
    main()
