#!/bin/sh
# auto/config — live-build configuration for InfinityOS
# Debian Trixie (13) base, KDE Plasma 6, privacy-first, gaming-ready.
#
# NOTE: --bootloaders and --debootstrap-options removed — not supported
# by all live-build versions. iso-hybrid handles BIOS+EFI automatically.
# ca-certificates comes in via the package list.

set -e

lb config noauto \
    --distribution         trixie \
    --architectures        amd64 \
    --binary-images        iso-hybrid \
    --archive-areas        "main contrib non-free non-free-firmware" \
    --backports            true \
    --apt-recommends       true \
    --apt-secure           true \
    --iso-application      "InfinityOS" \
    --iso-publisher        "Infinity Solutions LLC" \
    --iso-volume           "InfinityOS" \
    --memtest              none \
    --debian-installer     none \
    "${@}"
